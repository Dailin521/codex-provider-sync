  "exemptions": [
    {
      "id": "native-folder-picker-internals",
      "scope": "controls-created-inside-the-three-Windows-owned-FolderBrowserDialog-windows",
      "reason": "Windows owns their class names, hierarchy, and accessibility identifiers; only the application browse button and the selected isolated path form the supported contract.",
      "doesNotExempt": ["storage.codexHome.browse", "storage.sqliteHome.browse", "restore.execute"]
    },
    {
      "id": "native-message-box-internals",
      "scope": "child HWNDs and standard buttons created inside WinForms MessageBox windows",
      "reason": "WinForms delegates MessageBox hierarchy and native button identifiers to user32; launch controls, dialog text, result, and resulting application state remain test obligations.",
      "doesNotExempt": ["provider.addManual", "provider.removeManual", "operation.execute", "restore.execute", "backups.prune", "updates.check"]
    },
    {
      "id": "framework-composite-internals",
      "scope": "non-independent child HWNDs created by NumericUpDown and other registered WinForms composite controls",
      "reason": "These children implement a declared logical control and are not separate application entry points.",
      "doesNotExempt": ["backup.retentionCount"]
    }
  ]
